/-
  F5 scratch module: the "induction along the record sequence" angle.

  Three results, in decreasing order of importance.

  (A) THE INDUCTION STEP FAILS AT THE FIRST TRANSITION.  The record sequence
      starts 7, 13, 43, 139, ... and each record R generates the next by
      `R' = Cf + 1` where `(sf, Cf)` is the terminal state of R's canonical
      replay (`AttainmentIsFree.terminal_exit_reset`).  The natural induction
      on "the cap holds at the previous record" therefore has to pass from
      `M = 7` to `M = 13`.  It cannot: the cap HOLDS at 7 and FAILS at 13.
      So the induction hypothesis must carry the threshold, not merely inherit
      it -- a hypothesis of the form `lower <= M -> cap M` is not preserved by
      the step at its own lower end.

  (B) THE STEP BUDGET IS EXACTLY TWICE THE DOUBLE-HORIZON INCREMENT.
      `travel <= 2 * (Cf + p - C)` along a whole canonical replay, and
      `sf - (M+2) <= Cf + p - (2*M-2) = S + p`.  This turns the cap into a
      single closed-form arithmetic condition:

          8 * (S + p) <= 3 * M - 9        (EXC)

      which is the tree's `TravelExcessSum.relaxed_cap_of_excess_sum`
      hypothesis, reached here from the index side.

  (C) A CONSEQUENCE OF (A): the threshold in the target is not decoration.
      The target's `45895573 <= M` is not implied by, and cannot be replaced
      by, any appeal to the record structure, because the record structure's
      own first two steps already violate the threshold-free cap.

  NOT part of the repository.  No `sorry`, `admit`, `axiom`, `unsafe`.
-/
import A166944.ExcessGap
import A166944.RelaxedCap
import A166944.AttainmentIsFree
import A166944.TravelExcessSum
import A166944.CapBCandidates

set_option maxRecDepth 400000

namespace A166944Research

/-- The cap is violated at the `M = 13` terminal state (`CapBCandidates`).  Aliased
here so the statements below read as statements about the *cap*, not about
candidate B, since `RelaxedCap` showed the two are the same inequality. -/
theorem cap13_fails : ¬ (4 * 24 ≤ 7 * 13 - 1) := capB_fails_at_13

/-- The cap is violated at the `M = 43` terminal state (`CapBCandidates`). -/
theorem cap43_fails : ¬ (4 * 79 ≤ 7 * 43 - 1) := capB_fails_at_43

/-! ## (A) The induction step fails at the first transition

`AttainmentIsFree.terminal_exit_reset` says that the record following a canonical
replay with terminal horizon `Cf` sits at `Cf + 3` with value `Cf + 1`.  The
measured record sequence is `7, 13, 43, 139, ...`; the first pair is generated by
the `M = 7` replay, whose terminal state is `(9, 12)`, giving `Cf + 1 = 13`.

The cap holds at `M = 7` (`4 * 9 = 36 <= 48`) and fails at `M = 13`
(`4 * 24 = 96 > 90`).  Both are certified below, so the step
"cap at `R` implies cap at `R'`" is refuted by the first instance it can have. -/

/-! ### The `M = 7` canonical replay, certified

The window is `(9, 12]`: `D 9 = 12 = 2 * 7 - 2` and `d 9 = 7`, and no index in
`(9, 12]` is an event, so the replay is empty: `sf = 9`, `Cf = 12`, `p = 0`,
`S = 12 - 12 = 0`. -/

theorem st7 : IsMovingHorizonState 9 12 := ⟨by decide, by decide, by decide⟩

/-- **The `M = 7` canonical replay is a genuine zero-step path.** -/
theorem path7 : HasMovingHorizonPathTo (7 + 2) (2 * 7 - 2) 9 12 0 :=
  ⟨rfl, rfl, st7⟩

/-- **The window `(9, 12]` holds no event**, so the replay really is empty. -/
theorem seven_window_is_quiet : ∀ k : Fin 3, d (9 + 1 + k.val) = 1 := by decide

/-- The finite check behind `max7`. -/
theorem d_le_seven_upto_nine : ∀ k : Fin 8, d (k.val + 2) ≤ 7 := by decide

/-- **`IsAttainedPreviousMaximum 7 9`**: the running maximum through 9 is `7`,
attained at the canonical start `d 9 = 7` itself.  This is exactly the
`IsAttainedPreviousMaximum M (M + 2)` hypothesis the induction step consumes. -/
theorem max7 : IsAttainedPreviousMaximum 7 9 := by
  refine ⟨?_, ⟨9, by decide, by decide, by decide⟩⟩
  intro j hj2 hj9
  have hfin : d j ≤ 7 := by
    have hmem : j - 2 < 8 := by omega
    have hval := d_le_seven_upto_nine ⟨j - 2, hmem⟩
    have hidx : j - 2 + 2 = j := by omega
    simpa only [Fin.val_mk, hidx] using hval
  exact hfin

/-- **The cap HOLDS at `M = 7`**: `4 * 9 = 36 <= 48`. -/
theorem cap7_holds : 4 * 9 ≤ 7 * 7 - 1 := by decide

/-! ### The step's conclusion

The `M = 7` replay terminates at `Cf = 12`, so the next record is at `Cf + 3 = 15`
with value `Cf + 1 = 13`.  `AttainmentIsFree.terminal_exit_reset` proves the shape;
the value is kernel-checked here. -/

theorem seven_next_record_value : d (12 + 3) = 12 + 1 := by decide

/-- **`13` is a strict difference record and a canonical start.** -/
theorem thirteen_is_a_canonical_start :
    d (13 + 2) = 13 ∧ D (13 + 2) = 2 * 13 - 2 ∧ 13 + 2 < 2 * 13 - 2 := by decide

/-- **THE INDUCTION STEP FAILS AT ITS FIRST INSTANCE.**  The cap holds at the
record `7` and fails at the next record `13`, obtained from `7`'s replay by
`Cf + 1 = 13`.  Stated as the failure of the step, so that no proof attempt can
"inherit" the cap across the record sequence without carrying the threshold. -/
theorem cap_induction_step_fails_at_first_record :
    4 * 9 ≤ 7 * 7 - 1 ∧ ¬ (4 * 24 ≤ 7 * 13 - 1) ∧ d (12 + 3) = 12 + 1 :=
  ⟨cap7_holds, cap13_fails, seven_next_record_value⟩

/-- **The transfer is refuted as a universally quantified rule.**  Read it as
the induction step it is meant to be: from

  * `M`'s window `(M + 2, 2 * M - 2]` is quiet, so `M`'s replay is the zero-step
    path ending at `(sf, Cf)`,
  * `IsAttainedPreviousMaximum M sf`, and
  * the cap at `M`'s terminal index `sf`,

conclude the cap at the *next* record `Cf + 1`, whose own replay ends at
`(sf', Cf')`.

The pair `(M, sf, Cf, sf', Cf', p') = (7, 9, 12, 24, 42, 4)` is a counterexample:
`7`'s window is quiet (`seven_window_is_quiet`), the next record is `Cf + 1 = 13`,
`13`'s own replay ends at `(24, 42)` (`path13`), and `4 * 24 = 96 > 90`.  So no
threshold-free induction on "the cap holds at the previous record" exists. -/
theorem cap_does_not_transfer_along_records :
    ¬ (∀ M sf Cf sf' Cf' p' : Nat, d (M + 2) = M →
        HasMovingHorizonPathTo (M + 2) (2 * M - 2) sf Cf 0 →
        IsAttainedPreviousMaximum M sf → 4 * sf ≤ 7 * M - 1 →
        HasMovingHorizonPathTo (Cf + 1 + 2) (2 * (Cf + 1) - 2) sf' Cf' p' →
        IsAttainedPreviousMaximum (Cf + 1) sf' → 4 * sf' ≤ 7 * (Cf + 1) - 1) := by
  intro h
  have hbad := h 7 9 12 24 42 4 (by decide) path7 max7 cap7_holds path13 max13
  exact cap13_fails hbad

/-! ## (B) The step budget, and the closed form it produces

The per-step law `moving_horizon_step_gap_le_twice_increment`
(`r - s <= 2 * d r`) sums along a path to
`TravelExcessSum.path_travel_le_two_mul_excess`,

    sf - s <= 2 * (S + p),      S = sum (d r - 1),

which is proved unconditionally.  The replacement recorded here uses `Cf`
instead of `S`, which removes the need to name the sum:

    sf - s <= 2 * (Cf + p - C).

At a canonical start `(s, C) = (M + 2, 2 * M - 2)` and `Cf = (2 * M - 2) + S`,
so `Cf + p - C = S + p` and the two forms agree exactly.  The point of the `Cf`
form is that `Cf` is the path's own endpoint coordinate, so the bound needs no
existential and can be composed with the ledger lemmas. -/

/-- **Travel is at most twice the terminal horizon plus the event count**, minus
the starting horizon.  Unconditional in the path. -/
theorem path_travel_le_two_mul_horizon_add_count {s C sf Cf p : Nat}
    (hpath : HasMovingHorizonPathTo s C sf Cf p) :
    sf - s ≤ 2 * (Cf + p - C) := by
  induction p generalizing s C with
  | zero =>
      obtain ⟨hsf, hCf, _⟩ := hpath
      subst hsf; subst hCf
      omega
  | succ p ih =>
      obtain ⟨_, r, C', hstep, htail⟩ := hpath
      -- induction hypothesis at the tail, in the `Cf`-form
      have htail' : sf - r ≤ 2 * (Cf + p - C') := ih htail
      have hgap : r - s ≤ 2 * d r := moving_horizon_step_gap_le_twice_increment hstep
      have hupd : C' = C + (d r - 1) := moving_horizon_step_update hstep
      have hsr : s < r := hstep.2.1
      have hle : r ≤ sf := moving_horizon_path_index_le htail
      have hsplit : sf - s = (sf - r) + (r - s) := by omega
      -- the endpoint horizon is monotone along the path, so `C' <= Cf`
      have hDend : D sf = Cf := (moving_horizon_path_endpoint htail).2.1
      have hDr : D r = C' := hstep.2.2.2.2.2.2.1.symm
      have hC'Cf : C' ≤ Cf := by
        rw [← hDr, ← hDend]
        exact D_le_of_le hle
      have hdr1 : 1 ≤ d r := Nat.le_trans (by decide : 1 ≤ 3)
        (moving_horizon_step_event_ge_three hstep)
      -- the remaining horizon term grows by exactly `d r` across this step
      have hC'le : C' ≤ Cf + p := by omega
      have hexp : Cf + p - C' + d r = Cf + p - C + 1 := by omega
      have hgoal : Cf + (p + 1) - C = Cf + p - C + 1 := by omega
      have hcomb : 2 * (Cf + p - C') + 2 * d r = 2 * (Cf + (p + 1) - C) := by omega
      omega

/-- **The canonical closed form.**  At a canonical start the bound reads
`travel <= 2 * (Cf + p - (2 * M - 2))`, and with `S := Cf - (2 * M - 2)` this is
`travel <= 2 * (S + p)`. -/
theorem canonical_travel_le_two_mul_horizon_add_count {M sf Cf p : Nat}
    (hpath : HasMovingHorizonPathTo (M + 2) (2 * M - 2) sf Cf p) :
    sf - (M + 2) ≤ 2 * (Cf + p - (2 * M - 2)) :=
  path_travel_le_two_mul_horizon_add_count hpath

/-- **The two forms agree**, so the new bound is not a weakening of the tree's. -/
theorem horizon_add_count_eq_excess_add_count {M Cf S p : Nat}
    (hS : Cf = (2 * M - 2) + S) : Cf + p - (2 * M - 2) = S + p := by omega

/-- **The cap, as one closed-form arithmetic condition.**  Composing the bound
with `RelaxedCap.relaxed_cap_of_travel_bound`'s arithmetic: it is enough that
`8 * (S + p) <= 3 * M - 9`.  This is `TravelExcessSum.relaxed_cap_of_excess_sum`'s
hypothesis, reached from the index side; the composition is recorded so the single
missing input is unambiguous. -/
theorem cap_of_horizon_add_count_bound {M sf Cf p : Nat} (hM : 9 ≤ M)
    (hpath : HasMovingHorizonPathTo (M + 2) (2 * M - 2) sf Cf p)
    (hbound : 8 * (Cf + p - (2 * M - 2)) ≤ 3 * M - 9) :
    4 * sf ≤ 7 * M - 1 := by
  have htravel := path_travel_le_two_mul_horizon_add_count hpath
  have hsf : M + 2 ≤ sf := moving_horizon_path_index_le hpath
  have hsplit : (sf - (M + 2)) + (M + 2) = sf := Nat.sub_add_cancel hsf
  have h4 : 4 * (sf - (M + 2)) + 4 * (M + 2) = 4 * sf := by
    rw [← Nat.mul_add, hsplit]
  have hA : 4 * (sf - (M + 2)) ≤ 8 * (Cf + p - (2 * M - 2)) := by omega
  have h9 : 9 ≤ 3 * M := by omega
  have hB : 8 * (Cf + p - (2 * M - 2)) + 9 ≤ 3 * M := by omega
  omega

/-! ## (C) What this refutes about the threshold

The target's `45895573 ≤ M` cannot be discharged from the record structure: the
two smallest canonical starts are records `7` and `13`, they are consecutive in
the record sequence, and the cap changes from true to false between them.  So
`45895573 ≤ M` is a genuine extra hypothesis on `M`, not a consequence of "`M` is
a record", and the induction along records has to carry it as a disjunct. -/

theorem d_lt_seven_below_nine : ∀ k : Fin 7, d (k.val + 2) < 7 := by decide
theorem d_lt_thirteen_below_fifteen : ∀ k : Fin 13, d (k.val + 2) < 13 := by decide
theorem d_lt_forty_three_below_45 : ∀ k : Fin 43, d (k.val + 2) < 43 := by decide

/-- **`7` and `13` are consecutive in the record sequence, and the cap flips
between them.**  This is the single fact that rules out a threshold-free
induction. -/
theorem cap_flips_between_consecutive_records :
    d 9 = 7 ∧ d 15 = 13 ∧ 4 * 9 ≤ 7 * 7 - 1 ∧ ¬ (4 * 24 ≤ 7 * 13 - 1) ∧
      (∀ j : Nat, 2 ≤ j → j < 9 → d j < 7) ∧
      (∀ j : Nat, 2 ≤ j → j < 15 → d j < 13) := by
  refine ⟨by decide, by decide, by decide, by decide, ?_, ?_⟩
  · intro j hj2 hj9
    have hmem : j - 2 < 7 := by omega
    have := d_lt_seven_below_nine ⟨j - 2, hmem⟩
    have hidx : j - 2 + 2 = j := by omega
    simpa only [hidx] using this
  · intro j hj2 hj15
    have hmem : j - 2 < 13 := by omega
    have := d_lt_thirteen_below_fifteen ⟨j - 2, hmem⟩
    have hidx : j - 2 + 2 = j := by omega
    simpa only [hidx] using this


/-- **The threshold-free cap is false, and it is false at a record.**  `13` is a
strict difference record, and the cap fails at it.  So no argument of the form
"`M` is large because `M` is a record" can substitute for the explicit lower
bound in the target. -/
theorem cap_fails_at_a_record :
    IsDifferenceRecord 13 ∧ ¬ (4 * 24 ≤ 7 * 13 - 1) :=
  ⟨⟨15, by decide, by decide, fun j hj2 hj15 => by
      have hmem : j - 2 < 13 := by omega
      have := d_lt_thirteen_below_fifteen ⟨j - 2, hmem⟩
      have hidx : j - 2 + 2 = j := by omega
      simpa only [hidx] using this⟩,
    cap13_fails⟩

/-- **`7` is a strict difference record too**, so the flipping pair is a pair of
records and not an artefact of `7` or `13` being special in some other way. -/
theorem seven_is_a_record : IsDifferenceRecord 7 :=
  ⟨9, by decide, by decide, fun j hj2 hj9 => by
    have hmem : j - 2 < 7 := by omega
    have := d_lt_seven_below_nine ⟨j - 2, hmem⟩
    have hidx : j - 2 + 2 = j := by omega
    simpa only [hidx] using this⟩

/-- **The cap is FALSE at a record above the first two.**  `43` is a record
(`ExcessGap`), a greater twin prime, and a canonical start; the cap fails there.
Combined with `cap_fails_at_a_record`, the threshold-free cap fails at records
`13` and `43`, so "restrict to records" does not repair it. -/
theorem cap_fails_at_second_record :
    IsDifferenceRecord 43 ∧ ¬ (4 * 79 ≤ 7 * 43 - 1) :=
  ⟨⟨45, by decide, by decide, fun j hj2 hj45 => by
      have hmem : j - 2 < 43 := by omega
      have := d_lt_forty_three_below_45 ⟨j - 2, hmem⟩
      have hidx : j - 2 + 2 = j := by omega
      simpa only [hidx] using this⟩,
    cap43_fails⟩


