#print axioms cap_does_not_transfer_along_records
#print axioms path_travel_le_two_mul_horizon_add_count
#print axioms canonical_travel_le_two_mul_horizon_add_count
#print axioms cap_of_horizon_add_count_bound
#print axioms cap_flips_between_consecutive_records
#print axioms cap_fails_at_a_record
#print axioms seven_is_a_record
#print axioms cap_fails_at_second_record

end A166944Research
